        <mxCell id="n_account" value="&lt;div style=&quot;text-align:center;font-weight:bold&quot;&gt;ACCOUNT&lt;/div&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div&gt;&lt;b&gt;&lt;u&gt;id&lt;/u&gt;&lt;/b&gt; : UUID &lt;span style=&quot;font-size:9px&quot;&gt;— DEF gen_random_uuid()&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;user_id&lt;/i&gt; : UUID &lt;span style=&quot;font-size:9px&quot;&gt;— NN — REF users.id, ON DELETE CASCADE&lt;/span&gt;&lt;/div&gt;&lt;div&gt;provider_id : VARCHAR(50) &lt;span style=&quot;font-size:9px&quot;&gt;— NN&lt;/span&gt;&lt;/div&gt;&lt;div&gt;account_id : VARCHAR(255) &lt;span style=&quot;font-size:9px&quot;&gt;— NN&lt;/span&gt;&lt;/div&gt;&lt;div&gt;password : VARCHAR(255) &lt;span style=&quot;font-size:9px&quot;&gt;— NULL (requis si provider_id=credential)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;access_token : TEXT&lt;/div&gt;&lt;div&gt;refresh_token : TEXT&lt;/div&gt;&lt;div&gt;access_token_expires_at : TIMESTAMPTZ&lt;/div&gt;&lt;div&gt;created_at : TIMESTAMPTZ &lt;span style=&quot;font-size:9px&quot;&gt;— NN, DEF now()&lt;/span&gt;&lt;/div&gt;&lt;div&gt;updated_at : TIMESTAMPTZ &lt;span style=&quot;font-size:9px&quot;&gt;— NN, DEF now()&lt;/span&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div&gt;&lt;span style=&quot;font-size:9px;font-style:italic&quot;&gt;UNIQUE (provider_id, account_id)&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingBottom=6;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="40" width="400" height="266" as="geometry" /></mxCell>
        <mxCell id="n_twofactor" value="&lt;div style=&quot;text-align:center;font-weight:bold&quot;&gt;TWO_FACTOR&lt;/div&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div&gt;&lt;b&gt;&lt;u&gt;id&lt;/u&gt;&lt;/b&gt; : UUID &lt;span style=&quot;font-size:9px&quot;&gt;— DEF gen_random_uuid()&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;user_id&lt;/i&gt; : UUID &lt;span style=&quot;font-size:9px&quot;&gt;— NN, UQ — REF users.id, ON DELETE CASCADE&lt;/span&gt;&lt;/div&gt;&lt;div&gt;secret : VARCHAR(255) &lt;span style=&quot;font-size:9px&quot;&gt;— NN&lt;/span&gt;&lt;/div&gt;&lt;div&gt;backup_codes : TEXT &lt;span style=&quot;font-size:9px&quot;&gt;— NN&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingBottom=6;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="480" y="40" width="340" height="130" as="geometry" /></mxCell>
