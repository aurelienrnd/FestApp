        <mxCell id="n_session" value="&lt;div style=&quot;text-align:center;font-weight:bold&quot;&gt;SESSION&lt;/div&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div&gt;&lt;b&gt;&lt;u&gt;id&lt;/u&gt;&lt;/b&gt; : UUID &lt;span style=&quot;font-size:9px&quot;&gt;— DEF gen_random_uuid()&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;user_id&lt;/i&gt; : UUID &lt;span style=&quot;font-size:9px&quot;&gt;— NN — REF users.id, ON DELETE CASCADE&lt;/span&gt;&lt;/div&gt;&lt;div&gt;token : VARCHAR(255) &lt;span style=&quot;font-size:9px&quot;&gt;— NN, UQ&lt;/span&gt;&lt;/div&gt;&lt;div&gt;expires_at : TIMESTAMPTZ &lt;span style=&quot;font-size:9px&quot;&gt;— NN, CHK &gt; created_at&lt;/span&gt;&lt;/div&gt;&lt;div&gt;ip_address : VARCHAR(45)&lt;/div&gt;&lt;div&gt;user_agent : VARCHAR(255)&lt;/div&gt;&lt;div&gt;created_at : TIMESTAMPTZ &lt;span style=&quot;font-size:9px&quot;&gt;— NN, DEF now()&lt;/span&gt;&lt;/div&gt;&lt;div&gt;updated_at : TIMESTAMPTZ &lt;span style=&quot;font-size:9px&quot;&gt;— NN, DEF now()&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingBottom=6;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="340" width="340" height="210" as="geometry" /></mxCell>
        <mxCell id="n_users" value="&lt;div style=&quot;text-align:center;font-weight:bold&quot;&gt;USERS&lt;/div&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div&gt;&lt;b&gt;&lt;u&gt;id&lt;/u&gt;&lt;/b&gt; : UUID &lt;span style=&quot;font-size:9px&quot;&gt;— DEF gen_random_uuid()&lt;/span&gt;&lt;/div&gt;&lt;div&gt;email : CITEXT &lt;span style=&quot;font-size:9px&quot;&gt;— NN, UQ&lt;/span&gt;&lt;/div&gt;&lt;div&gt;display_name : CITEXT &lt;span style=&quot;font-size:9px&quot;&gt;— NN, UQ, CHK len≥2&lt;/span&gt;&lt;/div&gt;&lt;div&gt;role : user_role &lt;span style=&quot;font-size:9px&quot;&gt;— NN — ENUM(admin,artists,news)&lt;/span&gt;&lt;/div&gt;&lt;div&gt;email_verified : BOOLEAN &lt;span style=&quot;font-size:9px&quot;&gt;— NN, DEF false&lt;/span&gt;&lt;/div&gt;&lt;div&gt;image : VARCHAR(255)&lt;/div&gt;&lt;div&gt;password_changed_at : TIMESTAMPTZ&lt;/div&gt;&lt;div&gt;created_at : TIMESTAMPTZ &lt;span style=&quot;font-size:9px&quot;&gt;— NN, DEF now()&lt;/span&gt;&lt;/div&gt;&lt;div&gt;updated_at : TIMESTAMPTZ &lt;span style=&quot;font-size:9px&quot;&gt;— NN, DEF now()&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingBottom=6;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="420" y="340" width="380" height="230" as="geometry" /></mxCell>
        <mxCell id="n_news" value="&lt;div style=&quot;text-align:center;font-weight:bold&quot;&gt;NEWS&lt;/div&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div&gt;&lt;b&gt;&lt;u&gt;id&lt;/u&gt;&lt;/b&gt; : UUID &lt;span style=&quot;font-size:9px&quot;&gt;— DEF gen_random_uuid()&lt;/span&gt;&lt;/div&gt;&lt;div&gt;title : VARCHAR(150) &lt;span style=&quot;font-size:9px&quot;&gt;— NN, CHK len≥2&lt;/span&gt;&lt;/div&gt;&lt;div&gt;content : TEXT&lt;/div&gt;&lt;div&gt;is_published : BOOLEAN &lt;span style=&quot;font-size:9px&quot;&gt;— NN, DEF false&lt;/span&gt;&lt;/div&gt;&lt;div&gt;url_media : VARCHAR(255) &lt;span style=&quot;font-size:9px&quot;&gt;— NN&lt;/span&gt;&lt;/div&gt;&lt;div&gt;description_media : VARCHAR(255) &lt;span style=&quot;font-size:9px&quot;&gt;— NN&lt;/span&gt;&lt;/div&gt;&lt;div&gt;created_at : TIMESTAMPTZ &lt;span style=&quot;font-size:9px&quot;&gt;— NN, DEF now()&lt;/span&gt;&lt;/div&gt;&lt;div&gt;&lt;i&gt;user_id&lt;/i&gt; : UUID &lt;span style=&quot;font-size:9px&quot;&gt;— NULL — REF users.id, ON DELETE SET NULL&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingBottom=6;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="840" y="340" width="360" height="210" as="geometry" /></mxCell>
        <mxCell id="n_artists" value="&lt;div style=&quot;text-align:center;font-weight:bold&quot;&gt;ARTISTS&lt;/div&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div&gt;&lt;b&gt;&lt;u&gt;id&lt;/u&gt;&lt;/b&gt; : UUID &lt;span style=&quot;font-size:9px&quot;&gt;— DEF gen_random_uuid()&lt;/span&gt;&lt;/div&gt;&lt;div&gt;name : VARCHAR(150) &lt;span style=&quot;font-size:9px&quot;&gt;— NN, CHK len≥2&lt;/span&gt;&lt;/div&gt;&lt;div&gt;genre : VARCHAR(60) &lt;span style=&quot;font-size:9px&quot;&gt;— NN&lt;/span&gt;&lt;/div&gt;&lt;div&gt;origin : VARCHAR(80) &lt;span style=&quot;font-size:9px&quot;&gt;— NN&lt;/span&gt;&lt;/div&gt;&lt;div&gt;bio : TEXT &lt;span style=&quot;font-size:9px&quot;&gt;— NN&lt;/span&gt;&lt;/div&gt;&lt;div&gt;url_media : VARCHAR(255) &lt;span style=&quot;font-size:9px&quot;&gt;— NN&lt;/span&gt;&lt;/div&gt;&lt;div&gt;description_media : VARCHAR(255) &lt;span style=&quot;font-size:9px&quot;&gt;— NN&lt;/span&gt;&lt;/div&gt;&lt;div&gt;youtube_url : VARCHAR(255)&lt;/div&gt;&lt;div&gt;spotify_url : VARCHAR(255)&lt;/div&gt;&lt;div&gt;is_featured : BOOLEAN &lt;span style=&quot;font-size:9px&quot;&gt;— NN, DEF false&lt;/span&gt;&lt;/div&gt;&lt;hr size=&quot;1&quot;/&gt;&lt;div&gt;&lt;span style=&quot;font-size:9px;font-style:italic&quot;&gt;Trigger : max 2 lignes avec is_featured=true&lt;/span&gt;&lt;/div&gt;" style="rounded=0;whiteSpace=wrap;html=1;align=left;verticalAlign=top;spacingLeft=10;spacingTop=6;spacingBottom=6;strokeColor=#000000;fillColor=#FFFFFF;fontColor=#000000;fontSize=11;" vertex="1" parent="1"><mxGeometry x="40" y="640" width="380" height="266" as="geometry" /></mxCell>
