        <mxCell id="c12" value="1. redirige avec ?code=...&amp;state=..." style="endArrow=block;html=0;strokeColor=#000000;fontColor=#000000;fontSize=10;align=center;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150.0" y="100" as="sourcePoint" /><mxPoint x="410.0" y="100" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c13" value="2. GET /admin/auth/callback/google?code=...&amp;state=..." style="endArrow=block;html=0;strokeColor=#000000;fontColor=#000000;fontSize=10;align=center;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="410.0" y="155" as="sourcePoint" /><mxPoint x="670.0" y="155" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c14" value="3. delegue au handler catch-all Better Auth ; verifie le state" style="endArrow=block;html=0;strokeColor=#000000;fontColor=#000000;fontSize=10;align=center;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="670.0" y="210" as="sourcePoint" /><mxPoint x="930.0" y="210" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c15" value="4. echange code contre access_token" style="endArrow=block;html=0;strokeColor=#000000;fontColor=#000000;fontSize=10;align=center;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="930.0" y="265" as="sourcePoint" /><mxPoint x="150.0" y="265" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c16" value="5. access_token + profil (email, sub, verified_email)" style="endArrow=block;html=0;dashed=1;strokeColor=#000000;fontColor=#000000;fontSize=10;align=center;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="150.0" y="320" as="sourcePoint" /><mxPoint x="930.0" y="320" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c17" value="6. SELECT account WHERE providerId='google' AND accountId=sub" style="endArrow=block;html=0;strokeColor=#000000;fontColor=#000000;fontSize=10;align=center;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="930.0" y="375" as="sourcePoint" /><mxPoint x="1190.0" y="375" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c18" value="7. account | vide" style="endArrow=block;html=0;dashed=1;strokeColor=#000000;fontColor=#000000;fontSize=10;align=center;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1190.0" y="430" as="sourcePoint" /><mxPoint x="930.0" y="430" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c19" value="Si compte google deja lie -&gt; connexion directe.
Sinon, si email correspond a un USERS existant ET (email verifie par Google OU 'google' dans trustedProviders) ET accountLinking.enabled
  -&gt; liaison AUTOMATIQUE (INSERT account) SAUF si disableImplicitLinking=true (confirmation manuelle requise).
ATTENTION SECURITE : trustedProviders mal configure = risque de prise de compte (avertissement officiel Better Auth)." style="rounded=0;whiteSpace=wrap;html=0;align=left;verticalAlign=top;strokeColor=#000000;dashed=1;fillColor=none;fontColor=#000000;fontSize=10;fontStyle=2;spacingLeft=8;spacingTop=6;" vertex="1" parent="1"><mxGeometry x="890.0" y="485" width="340.0" height="130" as="geometry" /></mxCell>
        <mxCell id="c20" value="8. INSERT session pour l'utilisateur (nouveau ou lie)" style="endArrow=block;html=0;strokeColor=#000000;fontColor=#000000;fontSize=10;align=center;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="930.0" y="635" as="sourcePoint" /><mxPoint x="1190.0" y="635" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="c21" value="9. 302 + Set-Cookie session (redirection vers l'admin)" style="endArrow=block;html=0;dashed=1;strokeColor=#000000;fontColor=#000000;fontSize=10;align=center;verticalAlign=bottom;labelBackgroundColor=#FFFFFF;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="930.0" y="690" as="sourcePoint" /><mxPoint x="410.0" y="690" as="targetPoint" /></mxGeometry></mxCell>
